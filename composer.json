{
    "name": "dencel/laravel-eparaksts",
    "description": "Use Latvian eParaksts in your Laravel app.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "eparaksts",
        "eIDAS",
        "authentication",
        "signature",
        "SignAPI",
        "laravel"
    ],
    "authors": [
        {
            "name": "Deniss Celuiko",
            "email": "deniss.celuiko@gmail.com",
            "homepage": "https://celuiko.com/"
        }
    ],
    "homepage": "https://github.com/denissceluiko/laravel-eparaksts",
    "require": {
        "php": "^8.4",
        "dencel/eparaksts": "^0.3",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/session": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.4",
        "driftingly/rector-laravel": "^2.5"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Dencel\\LaravelEparaksts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dencel\\LaravelEparaksts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "fix": "php-cs-fixer fix",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "analyse": "php -d memory_limit=-1 vendor/bin/phpstan analyse",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dencel\\LaravelEparaksts\\EparakstsServiceProvider"
            ],
            "aliases": {
                "Eparaksts": "Dencel\\LaravelEparaksts\\Facades\\Eparaksts"
            }
        }
    }
}
